# ─────────────────────────────────────────────────────────────────────────────
# LegalEase AI – Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development, OR
# set these as Environment Variables in your Vercel project dashboard.

# URL of the deployed FastAPI backend (no trailing slash).
# Local dev default: http://127.0.0.1:8001
# Production example: https://legalease-ai-backend.onrender.com
VITE_API_URL=https://YOUR-RENDER-SERVICE-NAME.onrender.com
